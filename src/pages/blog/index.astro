---
import PostList from "../../components/PostList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts } from "../../lib/site-posts.mjs";

const posts = getPosts();
---

<BaseLayout title="文章" description="Yisoul 的研究、项目与技术写作。">
  <div class="page-narrow">
    <header class="page-heading reveal">
      <h1>文章</h1>
      <p>研究记录、工程判断，以及一些还在形成中的想法。</p>
    </header>
    <div class="reveal">
      <PostList posts={posts} empty="文章正在整理中。" />
    </div>
  </div>
</BaseLayout>

